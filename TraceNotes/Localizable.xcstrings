    "Every day’s tracks appear here once you’ve moved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every day’s tracks appear here once you’ve moved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動すると、すべての日の軌跡がここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动之后，所有日子的轨迹都会显示在这里。"
          }
        }
      }
    },
    "Every point Trace Notes records, and everything made from it, is stored only on this iPhone. Delete All Data in Settings removes it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace Notes が記録したすべての地点と、そこから作られたデータは、この iPhone にだけ保存されます。設定の「すべてのデータを削除」で消去できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace Notes 记录的每一个点，以及由它们生成的所有内容，都只保存在这台 iPhone 上。可以在设置里用“删除全部数据”清除。"
          }
        }
      }
    },
