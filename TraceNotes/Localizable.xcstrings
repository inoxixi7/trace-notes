    "Change transport mode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change transport mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動手段を変更"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改交通方式"
          }
        }
      }
