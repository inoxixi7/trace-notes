          "stringUnit": {
            "state": "translated",
            "value": "%@ – 現在"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – 现在"
          }
        }
      }
    },
    "%lld countries and regions": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
