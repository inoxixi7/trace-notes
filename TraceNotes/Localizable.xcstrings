    "Deletes every record, your changes to them and the Fog of World data. Your settings stay.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての記録、記録に加えた変更、世界の霧のデータを削除します。設定はそのまま残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除所有记录、你对记录做的修改以及世界迷雾的数据。设置会保留。"
          }
        }
      }
    },
    "Deleting…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除中…"
          }
        },
