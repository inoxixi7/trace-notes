    },
    "Stays and trips appear here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays and trips appear here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "滞在と移動がここに表示されます。"
          }
