    },
    "Subway (estimated)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subway (estimated)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地下鉄（推定）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地铁（推测）"
          }
        }
      }
    },
    "The file holds what the map shows: one track per day, without poor or estimated fixes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file holds what the map shows: one track per day, without poor or estimated fixes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの内容は地図の表示と同じです。1日ごとに1トラックで、精度の低い地点や推定の地点は含みません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件内容和地图显示的一致：每天一条轨迹，不含精度差或补存的点。"
          }
        }
      }
    },
    "The new name is shown for every visit to this place.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new name is shown for every visit to this place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所へのすべての訪問に新しい名前が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后每次来到这个地点都会显示新名称。"
          }
        }
      }
    },
    "The report couldn’t be made": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートを作成できませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成报告"
          }
        }
      }
    },
    "The timeline can’t be updated: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timeline can’t be updated: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムラインを更新できません：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新时间线：%@"
          }
        }
      }
    },
    "The track can’t be shown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The track can’t be shown"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌跡を表示できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法显示轨迹"
          }
        }
      }
    },
    "There is no account, no analytics, no advertising and no third-party code that sends anything anywhere.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントも、利用状況の分析も、広告もありません。どこかへ情報を送信するサードパーティのコードも含まれていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有账号、没有统计分析、没有广告，也没有任何会把数据发往别处的第三方代码。"
          }
        }
      }
    },
    "This GPX file has no tracks or routes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This GPX file has no tracks or routes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このGPXファイルにはトラックもルートもありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 GPX 文件里没有轨迹或路线。"
          }
        }
      }
    },
    "This can’t be undone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后无法恢复。"
          }
        }
      }
    },
    "This deletes %lld days and about %@ of records, and the Fog of World data. You can export GPX first.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This deletes %lld day and about %@ of records, and the Fog of World data. You can export GPX first."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This deletes %lld days and about %@ of records, and the Fog of World data. You can export GPX first."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日分・約 %@ の記録と、世界の霧のデータを削除します。先に GPX を書き出しておくこともできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除 %lld 天、约 %@ 的记录，以及世界迷雾的数据。可以先导出 GPX。"
          }
        }
      }
    },
    "This deletes %lld days and about %@ of records. You can export GPX first.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
