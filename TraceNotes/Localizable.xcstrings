{
  "sourceLanguage": "en",
  "strings": {
    "Can’t record in the background": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t record in the background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドで記録できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在后台记录"
          }
        }
      }
    },
    "Location Services are off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Services are off"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報サービスがオフです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位服务已关闭"
          }
        }
      }
    },
    "Location access is off for Trace Notes. Your saved history is still here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off for Trace Notes. Your saved history is still here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace Notesの位置情報がオフになっています。これまでの記録はそのまま見られます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace Notes 的定位权限已关闭。已有的记录仍可查看。"
          }
        }
      }
    },
    "Location access is set to “While Using the App”. Choose “Always” to keep recording when the app is closed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is set to “While Using the App”. Choose “Always” to keep recording when the app is closed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報が「このAppの使用中のみ許可」になっています。アプリを閉じていても記録するには「常に」を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位权限为“使用 App 期间”。要在关闭 App 后继续记录，请选择“始终”。"
          }
        }
      }
    },
    "Motion & Fitness is off, so transport is judged by speed only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion & Fitness is off, so transport is judged by speed only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モーションとフィットネス」がオフのため、移動手段は速度だけで判定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“运动与健身”未开启，交通方式只按速度判断。"
          }
        }
      }
    },
    "Next, allow location access “Always” and Motion & Fitness.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, allow location access “Always” and Motion & Fitness."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このあと、位置情報を「常に」に設定し、「モーションとフィットネス」を許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来，请把定位权限设为“始终”，并允许“运动与健身”。"
          }
        }
      }
    },
    "No settings. Trace Notes records all day in the background, even when the app is closed. Everything stays on this iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No settings. Trace Notes records all day in the background, even when the app is closed. Everything stays on this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定は不要です。アプリを閉じていても、Trace Notesが一日中バックグラウンドで記録します。データはすべてこのiPhoneの中に保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需任何设置。即使关闭 App，Trace Notes 也会在后台全天记录。所有数据都只保存在这台 iPhone 上。"
          }
        }
      }
    },
    "Not recording": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not recording"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録していません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未在记录"
          }
        }
      }
    },
    "Nothing recorded today yet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing recorded today yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の記録はまだありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还没有记录"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        }
      }
    },
    "Recording": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录中"
          }
        }
      }
    },
    "Restart the app. If this keeps happening, restart your iPhone.\n%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the app. If this keeps happening, restart your iPhone.\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを再起動してください。繰り返し起きる場合は、iPhoneを再起動してください。\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新启动 App。如果问题反复出现，请重新启动 iPhone。\n%@"
          }
        }
      }
    },
    "Start Recording": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Recording"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を始める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始记录"
          }
        }
      }
    },
    "Today’s track can’t be shown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s track can’t be shown"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の軌跡を表示できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法显示今天的轨迹"
          }
        }
      }
    },
    "Trace Notes can’t open its data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace Notes can’t open its data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace Notesのデータを開けません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace Notes 无法打开数据"
          }
        }
      }
    },
    "Turn on Location Services in Settings to record.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Location Services in Settings to record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録するには、「設定」で位置情報サービスをオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中打开定位服务以开始记录。"
          }
        }
      }
    },
    "Waiting for location access": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for location access"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報の許可を待っています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待定位权限"
          }
        }
      }
    },
    "Your footprints, kept as a diary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your footprints, kept as a diary"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの足跡を、日記のように"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把足迹写成日记"
          }
        }
      }
    },
    "Your track appears here as you move.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your track appears here as you move."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動すると、ここに軌跡が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动后，轨迹会显示在这里。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
