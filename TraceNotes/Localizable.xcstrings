    "To": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束日期"
          }
        }
      }
    },
    "To name the places where you stay, Trace Notes asks Apple’s map service for the address at that position. Apple handles these requests under its own privacy policy; they are not linked to you by Trace Notes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "滞在した場所に名前を付けるため、Trace Notes はその位置の住所を Apple のマップサービスに問い合わせます。この問い合わせは Apple のプライバシーポリシーに従って扱われ、Trace Notes があなたと結び付けることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了给你停留的地方起名字，Trace Notes 会向 Apple 地图服务查询那个位置的地址。这些查询按 Apple 自己的隐私政策处理，Trace Notes 不会把它们和你关联起来。"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
