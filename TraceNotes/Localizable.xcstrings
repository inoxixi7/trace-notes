    "All data was deleted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータを削除しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除全部数据。"
          }
        }
      }
    },
    "All records are deleted from this iPhone. Recording goes on from now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone からすべての記録が削除されます。記録はこのあとも続きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上的所有记录都会被删除，之后会照常继续记录。"
          }
        }
      }
    },
