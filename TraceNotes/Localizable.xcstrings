                "stringUnit": {
                  "state": "translated",
                  "value": "This deletes %lld days and about %@ of records. You can export GPX first."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日分・約 %@ の記録を削除します。先に GPX を書き出しておくこともできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
